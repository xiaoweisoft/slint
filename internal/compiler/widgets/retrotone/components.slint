import { RetroTonePalette, RetroToneFontSettings, RetroToneSizeSettings } from "styling.slint";

export component FocusBorder inherits Rectangle {
    border-width: 2px;
    border-color: RetroTonePalette.accent-background;
}

export component MenuBorder inherits Rectangle {
    background: transparent;

    Rectangle {
        border-width: 1px;
        border-color: RetroTonePalette.border;
    }
}

export component ListItem {
    in property <bool> is-selected;
    in property <StandardListViewItem> item;
    in property <bool> has-focus;
    in property <bool> has-hover;
    in property <bool> pressed;
    in property <int> index;
    in property <length> pressed-x;
    in property <length> pressed-y;

    min-width: i-layout.min-width;
    min-height: max(32px, i-layout.min-height);
    vertical-stretch: 0;
    horizontal-stretch: 1;
    accessible-role: list-item;
    accessible-label: root.item.text;
    accessible-item-selectable: true;
    accessible-item-selected: root.is-selected;
    accessible-item-index: root.index;

    states [
        pressed when root.pressed : {
            i-text.color: RetroTonePalette.accent-background;
        }
        hover when root.has-hover : {
            i-text.color: RetroTonePalette.foreground;
        }
        is-selected when root.is-selected : {
            i-text.color: RetroTonePalette.foreground;
            i-text.font-weight: RetroToneFontSettings.body-strong.font-weight;
        }
    ]

    if (root.has-focus) : FocusBorder {
        border-radius: 0px;
    }

    // Thin 2px accent left bar for selected state
    if root.is-selected : Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 2px;
        height: parent.height - 8px;
        background: RetroTonePalette.accent-background;
    }

    i-background := Rectangle {
        width: root.width;
        height: root.height;
        background: transparent;

        i-layout := HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 4px;

            i-text := Text {
                text: root.item.text;
                color: RetroTonePalette.text-secondary;
                font-size: RetroToneFontSettings.body.font-size;
                font-weight: RetroToneFontSettings.body.font-weight;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
                accessible-role: none;
            }
        }
    }

    @children
}
