import { ColorSchemeSelector } from "color-scheme.slint";

export struct TextStyle {
    font-size: relative-font-size,
    font-weight: int,
}

export global FluentFontSettings {
    out property <int> light-font-weight: 300;
    out property <int> regular-font-weight: 400;
    out property <int> semibold-font-weight: 600;
    out property <TextStyle> body: {
        font-size: 14 * 0.0769rem,
        font-weight: regular-font-weight
    };
    out property <TextStyle> body-strong: {
        font-size: 14 * 0.0769rem,
        font-weight: semibold-font-weight
    };
    out property <TextStyle> title: {
        font-size: 28 * 0.0769rem,
        font-weight: semibold-font-weight
    };
}

export global FluentPalette {
    in-out property <ColorScheme> color-scheme: ColorSchemeSelector.color-scheme;
    property <bool> dark-color-scheme: {
        if (color-scheme == ColorScheme.unknown) {
            return SlintInternal.color-scheme == ColorScheme.dark;
        }
        return color-scheme == ColorScheme.dark;
    }

    // Theme engine — "fluent" (default) or "retrotone" (low-res retro)
    in-out property <string> theme-engine: "fluent";
    property <bool> retro: theme-engine == "retrotone";

    // Font family — set from Rust, propagates through Palette singleton
    in-out property <string> font-family: "Microsoft YaHei";

    // Accent color overrides — set from Rust (user's chosen accent)
    // When alpha > 0, overrides the default accent for the respective theme engine.
    in-out property <color> accent-color-override: #00000000;
    in-out property <color> retro-accent-color-override: #00000000;

    // base palette — retrotone overrides with CRT amber (dark) / parchment (light) colors
    out property <brush> background:
        retro ? (dark-color-scheme ? #1A1A08 : #F0E8C8)
        : (dark-color-scheme ? #1C1C1C : #FAFAFA);
    out property <brush> foreground:
        retro ? (dark-color-scheme ? #E0D090 : #2A2810)
        : (dark-color-scheme ? #FFFFFF : #000000E6);
    out property <brush> alternate-background:
        retro ? (dark-color-scheme ? #2A2810 : #E0D8B0)
        : (dark-color-scheme ? #2C2C2C : #f0f0f0);
    out property <brush> alternate-foreground:
        retro ? (dark-color-scheme ? #E0D090 : #2A2810)
        : (dark-color-scheme ? #FFFFFF : #000000E6);
    out property <brush> control-background:
        retro ? (dark-color-scheme ? #33301A : #D8D098)
        : (dark-color-scheme ? #FFFFFF0F : #FFFFFFB3);
    out property <brush> control-foreground:
        retro ? (dark-color-scheme ? #E0D090 : #2A2810)
        : (dark-color-scheme ? #FFFFFF : #000000E6);
    out property <brush> accent-background:
        retro ? (retro-accent-color-override.alpha > 0 ? retro-accent-color-override
                 : (dark-color-scheme ? #F0A820 : #C88018))
        : (accent-color-override.alpha > 0 ? accent-color-override
           : (dark-color-scheme ? #60CDFF : #005FB8));
    out property <brush> accent-foreground:
        retro ? (dark-color-scheme ? #1A1A08 : #F0E8C8)
        : (dark-color-scheme ? #000000 : #FFFFFF);
    out property <brush> selection-background:
        retro ? (retro-accent-color-override.alpha > 0 ? retro-accent-color-override
                 : (dark-color-scheme ? #F0A820 : #C88018))
        : (accent-color-override.alpha > 0 ? accent-color-override : #0078D4);
    out property <brush> selection-foreground:
        retro ? (dark-color-scheme ? #1A1A08 : #F0E8C8)
        : (dark-color-scheme ? #000000 : #FFFFFF);
    out property <brush> border:
        retro ? (dark-color-scheme ? #605828 : #A09060)
        : (dark-color-scheme ? #FFFFFF14 : #00000073);

    // additional palette — retrotone uses flat, opaque variants derived from base colors
    out property <brush> secondary-accent-background:
        retro ? (retro-accent-color-override.alpha > 0 ? retro-accent-color-override.transparentize(10%)
                 : (dark-color-scheme ? #D89818 : #B07010))
        : (accent-color-override.alpha > 0 ? accent-color-override.transparentize(10%)
           : (dark-color-scheme ? #60CDFFE6 : #005FB8E6));
    out property <brush> tertiary-accent-background:
        retro ? (retro-accent-color-override.alpha > 0 ? retro-accent-color-override.transparentize(20%)
                 : (dark-color-scheme ? #C08810 : #986008))
        : (accent-color-override.alpha > 0 ? accent-color-override.transparentize(20%)
           : (dark-color-scheme ? #60CDFFCC : #005FB8CC));
    out property <brush> accent-disabled:
        retro ? (dark-color-scheme ? #504820 : #B0A880)
        : (dark-color-scheme ? #FFFFFF29 : #00000038);
    out property <brush> accent-control-border:
        retro ? border
        : (dark-color-scheme ? @linear-gradient(180deg, #FFFFFF14 90.67%, #00000024 100%)
        : @linear-gradient(180deg, #FFFFFF14 90.67%, #00000066 100%));
    out property <brush> control-border:
        retro ? border
        : (dark-color-scheme ? @linear-gradient(180deg, #FFFFFF17 0%, #00000012 8.33%)
        : @linear-gradient(180deg, #0000000F 90.58%, #00000029 100%));
    out property <brush> text-accent-foreground-secondary:
        retro ? (dark-color-scheme ? #A09060 : #5A5030)
        : (dark-color-scheme ? #00000080 : #FFFFFFB3);
    out property <brush> text-accent-foreground-disabled:
        retro ? (dark-color-scheme ? #706840 : #8A8060)
        : (dark-color-scheme ? #FFFFFF87 : #FFFFFF);
    out property <brush> text-secondary:
        retro ? (dark-color-scheme ? #A09060 : #5A5030)
        : (dark-color-scheme ? #FFFFFFC9 : #00000099);
    out property <brush> text-tertiary:
        retro ? (dark-color-scheme ? #706840 : #8A8060)
        : (dark-color-scheme ? #FFFFFF8A : #00000073);
    out property <brush> text-disabled:
        retro ? (dark-color-scheme ? #504820 : #B0A880)
        : (dark-color-scheme ? #FFFFFF5E : #0000005E);
    out property <brush> text-control-border:
        retro ? border
        : (dark-color-scheme ? @linear-gradient(180deg, #FFFFFF14 99.98%, #FFFFFF8A 100%, #FFFFFF8A 100%)
        : @linear-gradient(180deg, #0000000F 99.99%, #00000073 100%, #00000073 100%));
    out property <brush> control-secondary:
        retro ? (dark-color-scheme ? #2A2810 : #E0D8B0)
        : (dark-color-scheme ? #FFFFFF14 : #F9F9F980);
    out property <brush> control-tertiary:
        retro ? (dark-color-scheme ? #222008 : #D0C8A0)
        : (dark-color-scheme ? #FFFFFF08 : #F9F9F94D);
    out property <brush> control-disabled:
        retro ? (dark-color-scheme ? #1A1808 : #C8C098)
        : (dark-color-scheme ? #FFFFFF0A : #F9F9F94D);
    out property <brush> control-alt-secondary:
        retro ? (dark-color-scheme ? #222008 : #D8D098)
        : (dark-color-scheme ? #0000001A : #00000005);
    out property <brush> control-alt-tertiary:
        retro ? (dark-color-scheme ? #2A2810 : #D0C8A0)
        : (dark-color-scheme ? #FFFFFF0A : #0000000F);
    out property <brush> control-alt-quartiary:
        retro ? (dark-color-scheme ? #33301A : #C8C090)
        : (dark-color-scheme ? #FFFFFF12 : #00000017);
    out property <brush> control-alt-disabled: transparent;
    out property <brush> control-strong-stroke:
        retro ? border
        : (dark-color-scheme ? #FFFFFF99 : #00000099);
    out property <brush> control-strong-stroke-disabled:
        retro ? (dark-color-scheme ? #504820 : #B0A880)
        : (dark-color-scheme ? #FFFFFF29 : #00000038);
    out property <brush> control-solid:
        retro ? (dark-color-scheme ? #33301A : #D8D098)
        : (dark-color-scheme ? #454545: #FFFFFF);
    out property <brush> circle-border:
        retro ? border
        : (dark-color-scheme ? @linear-gradient(180deg, #FFFFFF17 0%, #FFFFFF12 100%)
    : @linear-gradient(180deg, #0000000F 0%, #00000029 100%));
    out property <brush> control-input-active:
        retro ? (dark-color-scheme ? #1A1A08 : #F0E8C8)
        : (dark-color-scheme ? #1E1E1EB3 : #FFFFFF);
    out property <brush> focus-stroke-inner:
        retro ? (dark-color-scheme ? #1A1A08 : #F0E8C8)
        : (dark-color-scheme ? #000000B3 : #FFFFFF);
    out property <brush> focus-stroke-outer:
        retro ? (dark-color-scheme ? #F0A820 : #C88018)
        : (dark-color-scheme ? #FFFFFF : #000000E6);
    out property <brush> control-background-stroke-flyout:
        retro ? border
        : (dark-color-scheme ? #00000033 : #0000000F);
    out property <brush> sub-title-secondary:
        retro ? (dark-color-scheme ? #222008 : #E0D8B0)
        : (dark-color-scheme ? #FFFFFF0F : #0000000A);
    out property <brush> sub-title-tertiary:
        retro ? (dark-color-scheme ? #1A1808 : #D8D098)
        : (dark-color-scheme ? #FFFFFF0A : #00000005);
    out property <brush> shadow:
        retro ? transparent
        : (dark-color-scheme ? #00000042 : #00000024);
    out property <brush> subtle:
        retro ? (dark-color-scheme ? #222008 : #E0D8B0)
        : (dark-color-scheme ? #FFFFFF0F : #0000000A);
    out property <brush> subtle-secondary:
        retro ? (dark-color-scheme ? #222008 : #E0D8B0)
        : (dark-color-scheme ? #FFFFFF0F : #0000000A);
    out property <brush> subtle-tertiary:
        retro ? (dark-color-scheme ? #1A1808 : #D8D098)
        : (dark-color-scheme ? #FFFFFF0A : #00000005);
    out property <brush> divider:
        retro ? (dark-color-scheme ? #3A3418 : #C8C0A0)
        : (dark-color-scheme ? #FFFFFF14 : #00000014);
    out property <brush> layer-on-mica-base-alt:
        retro ? (dark-color-scheme ? #2A2810 : #E0D8B0)
        : (dark-color-scheme ? #3A3A3A73 : #FFFFFFB3);
    out property <brush> layer-on-mica-base-alt-secondary:
        retro ? (dark-color-scheme ? #222008 : #D8D098)
        : (dark-color-scheme ? #FFFFFF0F : #0000000A);
    out property <brush> card-stroke:
        retro ? border
        : (dark-color-scheme ? #0000001A : #0000000F);
    out property <brush> state:
        retro ? foreground
        : (dark-color-scheme ? #ffffff : #000000);
    out property <brush> state-secondary:
        retro ? background
        : (dark-color-scheme ? #000000 : #ffffff);
}

export global Icons {
    out property <image> arrow-down: @image-url("_arrow-down.svg");
    out property <image> arrow-up: @image-url("_arrow-up.svg");
    out property <image> check-mark: @image-url("_check-mark.svg");
    out property <image> chevron-down: @image-url("_chevron-down.svg");
    out property <image> chevron-up: @image-url("_chevron-up.svg");
    out property <image> down: @image-url("_down.svg");
    out property <image> dropdown: @image-url("_dropdown.svg");
    out property <image> left: @image-url("_left.svg");
    out property <image> right: @image-url("_right.svg");
    out property <image> up: @image-url("_up.svg");
    out property <image> keyboard: @image-url("_keyboard.svg");
    out property <image> clock: @image-url("_clock.svg");
    out property <image> arrow-back: @image-url("_arrow_back.svg");
    out property <image> arrow-forward: @image-url("_arrow_forward.svg");
    out property <image> edit: @image-url("_edit.svg");
    out property <image> calendar: @image-url("_calendar.svg");
}

export global FluentSizeSettings {
    out property <length> item-height: 40px;
}
