import { Fluent2Palette, Fluent2FontSettings, Fluent2SizeSettings } from "styling.slint";

export component FocusBorder {
    in property <length> border-radius;

    outer := Rectangle {
        x: -Fluent2SizeSettings.focus-ring-gap;
        y: -Fluent2SizeSettings.focus-ring-gap;
        width: parent.width + 2 * Fluent2SizeSettings.focus-ring-gap;
        height: parent.height + 2 * Fluent2SizeSettings.focus-ring-gap;
        border-width: Fluent2SizeSettings.focus-stroke-width;
        border-color: Fluent2Palette.focus-stroke-outer;
        border-radius: root.border-radius + Fluent2SizeSettings.focus-ring-radius-adjust;

        Rectangle {
            x: parent.border-width;
            y: parent.border-width;
            width: parent.width - 2 * parent.border-width;
            height: parent.height - 2 * parent.border-width;
            border-width: Fluent2SizeSettings.focus-ring-inner-stroke-width;
            border-radius: parent.border-radius - Fluent2SizeSettings.focus-stroke-width;
            border-color: Fluent2Palette.focus-stroke-inner;
        }
    }
}

export component MenuBorder inherits Rectangle {
    border-radius: Fluent2SizeSettings.overlay-radius;
    background: Fluent2Palette.menu-flyout-background;
    drop-shadow-blur: Fluent2SizeSettings.elevation-shadow-flyout-blur;
    drop-shadow-offset-y: Fluent2SizeSettings.elevation-shadow-flyout-offset-y;
    drop-shadow-color: Fluent2Palette.elevation-shadow-flyout-color;

    Rectangle {
        border-width: Fluent2SizeSettings.stroke-width;
        border-radius: parent.border-radius;
        border-color: Fluent2Palette.menu-flyout-border;
    }
}

export component ListItem {
    in property <bool> is-selected;
    in property <StandardListViewItem> item;
    in property <bool> has-focus;
    in property <bool> has-hover;
    in property <bool> pressed;
    in property <int> index;
    in property <length> pressed-x;
    in property <length> pressed-y;

    min-width: i-layout.min-width;
    min-height: max(Fluent2SizeSettings.item-height, i-layout.min-height);
    vertical-stretch: 0;
    horizontal-stretch: 1;
    accessible-role: list-item;
    accessible-label: root.item.text;
    accessible-item-selectable: true;
    accessible-item-selected: root.is-selected;
    accessible-item-index: root.index;

    states [
        pressed when root.pressed : {
            i-background.background: is-selected ? Fluent2Palette.list-item-selected-pressed-background : Fluent2Palette.list-item-pressed-background;
        }
        hover when root.has-hover : {
            i-text.color: Fluent2Palette.list-item-hover-foreground;
            i-background.background: is-selected ? Fluent2Palette.list-item-selected-hover-background : Fluent2Palette.list-item-hover-background;
            i-selector.height: root.is-selected ? Fluent2SizeSettings.selection-indicator-height : Fluent2SizeSettings.selection-indicator-hidden-height;
        }
        is-selected when root.is-selected : {
            i-background.background: Fluent2Palette.list-item-selected-background;
            i-selector.height: Fluent2SizeSettings.selection-indicator-height;
        }
    ]

    if (root.has-focus) : FocusBorder {
        border-radius: Fluent2SizeSettings.control-radius;
    }

    i-background := Rectangle {
        width: root.width - Fluent2SizeSettings.list-item-horizontal-inset;
        height: root.height - Fluent2SizeSettings.list-item-vertical-inset;
        background: Fluent2Palette.list-item-background;
        border-radius: Fluent2SizeSettings.control-radius;

        animate background { duration: Fluent2SizeSettings.control-motion-duration; }

        i-layout := HorizontalLayout {
            padding-left: Fluent2SizeSettings.list-item-horizontal-padding;
            padding-right: Fluent2SizeSettings.list-item-horizontal-padding;
            spacing: Fluent2SizeSettings.overlay-padding;

            i-text := Text {
                text: root.item.text;
                color: Fluent2Palette.list-item-foreground;
                font-size: Fluent2FontSettings.body.font-size;
                font-weight: Fluent2FontSettings.body.font-weight;
                font-family: Fluent2Palette.font-family;
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
                accessible-role: none;

                animate color { duration: Fluent2SizeSettings.control-motion-duration; }
            }
        }

        i-selector := Rectangle {
            x: Fluent2SizeSettings.selection-indicator-offset;
            y: (parent.height - self.height) / 2;
            width: Fluent2SizeSettings.selection-indicator-width;
            height: Fluent2SizeSettings.selection-indicator-hidden-height;
            background: Fluent2Palette.list-item-selection-indicator-background;
            border-radius: Fluent2SizeSettings.selection-indicator-radius;

            animate height { duration: Fluent2SizeSettings.control-motion-duration; easing: ease-out; }
        }
    }

    @children
}
