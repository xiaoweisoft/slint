import { ColorSchemeSelector } from "color-scheme.slint";

export struct TextStyle {
    font-size: relative-font-size,
    font-weight: int,
}

export global Fluent2FontSettings {
    out property <int> regular-font-weight: 400;
    out property <int> medium-font-weight: 500;
    out property <int> semibold-font-weight: 600;
    out property <TextStyle> caption: {
        font-size: 12 * 0.0769rem,
        font-weight: regular-font-weight
    };
    out property <TextStyle> body: {
        font-size: 14 * 0.0769rem,
        font-weight: regular-font-weight
    };
    out property <TextStyle> body-strong: {
        font-size: 14 * 0.0769rem,
        font-weight: semibold-font-weight
    };
    out property <TextStyle> title: {
        font-size: 28 * 0.0769rem,
        font-weight: semibold-font-weight
    };
}

export global Fluent2Palette {
    in-out property <ColorScheme> color-scheme: ColorSchemeSelector.color-scheme;
    property <bool> dark-color-scheme: {
        if (color-scheme == ColorScheme.unknown) {
            return SlintInternal.color-scheme == ColorScheme.dark;
        }
        return color-scheme == ColorScheme.dark;
    }

    // Public bridge settings. These stay API-compatible with the existing Palette singleton,
    // but the fluent2 namespace does not branch into the older retrotone palette.
    in-out property <string> theme-engine: "fluent2";
    in-out property <string> font-family: "Segoe UI";
    in-out property <color> accent-color-override: #00000000;
    in-out property <color> retro-accent-color-override: #00000000;

    property <brush> neutral-background-1: dark-color-scheme ? #1B1A19 : #FFFFFF;
    property <brush> neutral-background-2: dark-color-scheme ? #242322 : #FAFAFA;
    property <brush> neutral-background-3: dark-color-scheme ? #2E2D2C : #F5F5F5;
    property <brush> neutral-background-4: dark-color-scheme ? #3A3837 : #F0F0F0;
    property <brush> neutral-foreground-1: dark-color-scheme ? #FFFFFF : #242424;
    property <brush> neutral-foreground-2: dark-color-scheme ? #D6D6D6 : #424242;
    property <brush> neutral-foreground-3: dark-color-scheme ? #ADADAD : #616161;
    property <brush> neutral-foreground-disabled: dark-color-scheme ? #5C5C5C : #BDBDBD;
    property <brush> neutral-stroke-1: dark-color-scheme ? #666666 : #D1D1D1;
    property <brush> neutral-stroke-2: dark-color-scheme ? #525252 : #E0E0E0;
    property <brush> neutral-stroke-subtle: dark-color-scheme ? #3D3D3D : #EDEBE9;
    property <brush> neutral-stroke-focus-inner: dark-color-scheme ? #000000B3 : #FFFFFF;
    property <brush> neutral-stroke-focus-outer: dark-color-scheme ? #FFFFFF : #000000E6;

    property <brush> accent-fill: accent-color-override.alpha > 0 ? accent-color-override : (dark-color-scheme ? #479EF5 : #0F6CBD);
    property <brush> accent-fill-hover: accent-color-override.alpha > 0 ? accent-color-override.transparentize(8%) : (dark-color-scheme ? #62ABF5 : #115EA3);
    property <brush> accent-fill-pressed: accent-color-override.alpha > 0 ? accent-color-override.transparentize(18%) : (dark-color-scheme ? #2886DE : #0F548C);
    property <brush> accent-fill-disabled: dark-color-scheme ? #2E2E2E : #F0F0F0;
    property <brush> accent-foreground-1: #FFFFFF;
    property <brush> accent-foreground-2: dark-color-scheme ? #000000 : #FFFFFF;
    property <brush> accent-foreground-disabled: dark-color-scheme ? #8A8A8A : #BDBDBD;

    property <brush> control-fill: dark-color-scheme ? #FFFFFF0F : #FFFFFFB3;
    property <brush> control-fill-hover: dark-color-scheme ? #FFFFFF14 : #F5F5F5;
    property <brush> control-fill-pressed: dark-color-scheme ? #FFFFFF0A : #EDEDED;
    property <brush> control-fill-disabled: dark-color-scheme ? #FFFFFF0A : #F5F5F5;
    property <brush> control-fill-transparent: transparent;
    property <brush> control-fill-subtle: dark-color-scheme ? #FFFFFF0F : #0000000A;
    property <brush> control-fill-subtle-hover: dark-color-scheme ? #FFFFFF14 : #0000000F;
    property <brush> control-fill-subtle-pressed: dark-color-scheme ? #FFFFFF0A : #00000014;
    property <brush> control-fill-solid: dark-color-scheme ? #454545 : #FFFFFF;
    property <brush> input-fill-active: dark-color-scheme ? #1E1E1E : #FFFFFF;
    property <brush> flyout-stroke: dark-color-scheme ? #00000033 : #0000000F;
    property <brush> shadow-ambient: dark-color-scheme ? #00000052 : #00000024;
    property <brush> shadow-key: dark-color-scheme ? #00000066 : #0000001F;

    out property <brush> background: neutral-background-1;
    out property <brush> foreground: neutral-foreground-1;
    out property <brush> alternate-background: neutral-background-3;
    out property <brush> alternate-foreground: neutral-foreground-1;
    out property <brush> control-background: control-fill;
    out property <brush> control-foreground: neutral-foreground-1;
    out property <brush> accent-background: accent-fill;
    out property <brush> accent-foreground: accent-foreground-1;
    out property <brush> selection-background: accent-fill;
    out property <brush> selection-foreground: accent-foreground-1;
    out property <brush> border: neutral-stroke-1;

    out property <brush> secondary-accent-background: accent-fill-hover;
    out property <brush> tertiary-accent-background: accent-fill-pressed;
    out property <brush> accent-disabled: accent-fill-disabled;
    out property <brush> accent-control-border: dark-color-scheme ? @linear-gradient(180deg, #FFFFFF14 90.67%, #00000024 100%) : @linear-gradient(180deg, #FFFFFF14 90.67%, #00000066 100%);
    out property <brush> control-border: dark-color-scheme ? @linear-gradient(180deg, #FFFFFF17 0%, #00000012 8.33%) : @linear-gradient(180deg, #0000000F 90.58%, #00000029 100%);
    out property <brush> text-accent-foreground-secondary: dark-color-scheme ? #00000080 : #FFFFFFB3;
    out property <brush> text-accent-foreground-disabled: accent-foreground-disabled;
    out property <brush> text-secondary: neutral-foreground-2;
    out property <brush> text-tertiary: neutral-foreground-3;
    out property <brush> text-disabled: neutral-foreground-disabled;
    out property <brush> switch-thumb-disabled: text-secondary;
    out property <brush> switch-thumb-checked-disabled: text-accent-foreground-disabled;
    out property <brush> text-control-border: dark-color-scheme ? @linear-gradient(180deg, #FFFFFF14 99.98%, #FFFFFF8A 100%, #FFFFFF8A 100%) : @linear-gradient(180deg, #0000000F 99.99%, #00000073 100%, #00000073 100%);
    out property <brush> control-secondary: control-fill-hover;
    out property <brush> control-tertiary: control-fill-pressed;
    out property <brush> control-disabled: control-fill-disabled;
    out property <brush> control-alt-secondary: dark-color-scheme ? #0000001A : #00000005;
    out property <brush> control-alt-tertiary: dark-color-scheme ? #FFFFFF0A : #0000000F;
    out property <brush> control-alt-quartiary: dark-color-scheme ? #FFFFFF12 : #00000017;
    out property <brush> control-alt-disabled: transparent;
    out property <brush> control-strong-stroke: dark-color-scheme ? #FFFFFF99 : #00000099;
    out property <brush> control-strong-stroke-disabled: dark-color-scheme ? #FFFFFF29 : #00000038;
    out property <brush> control-solid: control-fill-solid;
    out property <brush> circle-border: dark-color-scheme ? @linear-gradient(180deg, #FFFFFF17 0%, #FFFFFF12 100%) : @linear-gradient(180deg, #0000000F 0%, #00000029 100%);
    out property <brush> control-input-active: input-fill-active;
    out property <brush> focus-stroke-inner: neutral-stroke-focus-inner;
    out property <brush> focus-stroke-outer: neutral-stroke-focus-outer;
    out property <brush> control-background-stroke-flyout: flyout-stroke;
    out property <brush> sub-title-secondary: control-fill-subtle;
    out property <brush> sub-title-tertiary: control-fill-subtle-pressed;
    out property <brush> shadow: shadow-ambient;
    out property <brush> elevation-shadow-rest-color: shadow-key;
    out property <brush> elevation-shadow-flyout-color: shadow-ambient;
    out property <brush> subtle: control-fill-subtle;
    out property <brush> subtle-secondary: control-fill-subtle-hover;
    out property <brush> subtle-tertiary: control-fill-subtle-pressed;
    out property <brush> divider: neutral-stroke-subtle;
    out property <brush> layer-on-mica-base-alt: dark-color-scheme ? #3A3A3A73 : #FFFFFFB3;
    out property <brush> layer-on-mica-base-alt-secondary: control-fill-subtle;
    out property <brush> card-stroke: dark-color-scheme ? #0000001A : #0000000F;
    out property <brush> state: dark-color-scheme ? #FFFFFF : #000000;
    out property <brush> state-secondary: dark-color-scheme ? #000000 : #FFFFFF;
}

export global Icons {
    out property <image> arrow-down: @image-url("_arrow-down.svg");
    out property <image> arrow-up: @image-url("_arrow-up.svg");
    out property <image> check-mark: @image-url("_check-mark.svg");
    out property <image> chevron-down: @image-url("_chevron-down.svg");
    out property <image> chevron-up: @image-url("_chevron-up.svg");
    out property <image> down: @image-url("_down.svg");
    out property <image> dropdown: @image-url("_dropdown.svg");
    out property <image> left: @image-url("_left.svg");
    out property <image> right: @image-url("_right.svg");
    out property <image> up: @image-url("_up.svg");
    out property <image> keyboard: @image-url("_keyboard.svg");
    out property <image> clock: @image-url("_clock.svg");
    out property <image> arrow-back: @image-url("_arrow_back.svg");
    out property <image> arrow-forward: @image-url("_arrow_forward.svg");
    out property <image> edit: @image-url("_edit.svg");
    out property <image> calendar: @image-url("_calendar.svg");
}

