    out property <length> time-clock-center-dot-size: 8px;
    out property <length> time-clock-inner-dot-size: 4px;
    out property <length> time-clock-outer-padding: 2px;
    out property <length> time-clock-inner-padding: 32px;
    out property <length> time-input-width: 96px;
    out property <length> time-input-height: 80px;
    out property <length> period-selector-min-width: 38px;
    out property <TextStyle> time-input-display: {
        font-size: 57 * 0.0625rem,
        font-weight: Fluent2FontSettings.regular-font-weight
    };
    out property <duration> control-motion-duration: 150ms;
}
