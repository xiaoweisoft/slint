    property <brush> surface-card-stroke: dark-color-scheme ? #0000001A : #0000000F;
    property <brush> shadow-ambient: dark-color-scheme ? #00000052 : #00000024;
    property <brush> shadow-key: dark-color-scheme ? #00000066 : #0000001F;
    property <brush> state-layer-brush: dark-color-scheme ? #FFFFFF : #000000;
    property <brush> state-layer-on-accent-brush: dark-color-scheme ? #000000 : #FFFFFF;
    property <brush> control-icon-foreground-fill: neutral-foreground-2;
    property <brush> control-icon-pressed-foreground-fill: neutral-foreground-3;
    property <brush> control-icon-border-foreground-fill: neutral-stroke-1;
    property <brush> combobox-icon-foreground-fill: control-icon-foreground-fill;
    property <brush> combobox-icon-pressed-foreground-fill: control-icon-pressed-foreground-fill;
    property <brush> spinbox-button-icon-foreground-fill: control-icon-foreground-fill;
