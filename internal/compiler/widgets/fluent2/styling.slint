    out property <length> switch-thumb-pressed-height: 14px;
    out property <length> slider-track-size: 4px;
    out property <length> slider-track-radius: 2px;
    out property <length> slider-thumb-size: 20px;
    out property <length> slider-thumb-border-size: 21px;
    out property <length> slider-thumb-radius: 10px;
