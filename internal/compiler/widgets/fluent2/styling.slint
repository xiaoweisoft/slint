    out property <float> picker-state-opacity-disabled: 0.38;
    out property <float> disabled-opacity: 0.5;
    out property <length> tab-scroll-delta: control-scroll-delta;
    out property <length> date-delegate-size: 40px;
    out property <length> date-year-delegate-width: 72px;
    out property <length> time-clock-size: 256px;
