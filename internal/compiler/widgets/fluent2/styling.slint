    out property <length> slider-thumb-pressed-size: 10px;
    out property <length> slider-thumb-hover-size: 14px;
    out property <length> slider-focus-scope-size: 0px;
    out property <length> switch-thumb-hover-size: 14px;
    out property <length> icon-size: 12px;
    out property <length> button-icon-size: 20px;
    out property <length> lineedit-icon-size: 16px;
    out property <length> lineedit-icon-touch-target: compact-control-height;
    out property <length> combobox-icon-offset-y: 2px;
    out property <length> combobox-popup-offset-y: -4px;
    out property <length> menu-bar-height: 40px;
    out property <length> menu-bar-item-bottom-padding: 6px;
    out property <length> menu-separator-height: 9px;
    out property <length> menu-item-outer-padding: 1px;
    out property <length> menu-item-vertical-padding: 0px;
    out property <length> menu-item-content-spacing: 8px;
    out property <length> menu-frame-margin: 5px;
