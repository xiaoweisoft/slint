import { ColorSchemeSelector } from "color-scheme.slint";

export struct TextStyle {
    font-size: relative-font-size,
    font-weight: int,
}

export global Fluent2FontSettings {
    out property <int> regular-font-weight: 400;
    out property <int> medium-font-weight: 500;
    out property <int> semibold-font-weight: 600;
    out property <TextStyle> caption: {
        font-size: 12 * 0.0769rem,
        font-weight: regular-font-weight
    };
    out property <TextStyle> body: {
        font-size: 14 * 0.0769rem,
        font-weight: regular-font-weight
    };
    out property <TextStyle> body-strong: {
        font-size: 14 * 0.0769rem,
        font-weight: semibold-font-weight
    };
    out property <TextStyle> title: {
        font-size: 28 * 0.0769rem,
        font-weight: semibold-font-weight
    };
}

export global Fluent2Palette {
    in-out property <ColorScheme> color-scheme: ColorSchemeSelector.color-scheme;
    property <bool> dark-color-scheme: {
        if (color-scheme == ColorScheme.unknown) {
            return SlintInternal.color-scheme == ColorScheme.dark;
        }
        return color-scheme == ColorScheme.dark;
    }

    // Public bridge settings. These stay API-compatible with the existing Palette singleton,
    // but the fluent2 namespace does not branch into the older retrotone palette.
    in-out property <string> theme-engine: "fluent2";
    in-out property <string> font-family: "Segoe UI";
    in-out property <color> accent-color-override: #00000000;
    in-out property <color> retro-accent-color-override: #00000000;

    property <brush> neutral-background-1: dark-color-scheme ? #1B1A19 : #FFFFFF;
    property <brush> neutral-background-2: dark-color-scheme ? #242322 : #FAFAFA;
    property <brush> neutral-background-3: dark-color-scheme ? #2E2D2C : #F5F5F5;
    property <brush> neutral-background-4: dark-color-scheme ? #3A3837 : #F0F0F0;
    property <brush> neutral-background-transparent: control-fill-transparent;
    property <brush> neutral-foreground-1: dark-color-scheme ? #FFFFFF : #242424;
    property <brush> neutral-foreground-2: dark-color-scheme ? #D6D6D6 : #424242;
    property <brush> neutral-foreground-3: dark-color-scheme ? #ADADAD : #616161;
    property <brush> neutral-foreground-disabled: dark-color-scheme ? #5C5C5C : #BDBDBD;
    property <brush> neutral-stroke-1: dark-color-scheme ? #666666 : #D1D1D1;
    property <brush> neutral-stroke-2: dark-color-scheme ? #525252 : #E0E0E0;
    property <brush> neutral-stroke-subtle: dark-color-scheme ? #3D3D3D : #EDEBE9;
    property <brush> neutral-stroke-transparent: control-fill-transparent;
    property <brush> neutral-stroke-strong: dark-color-scheme ? #FFFFFF99 : #00000099;
    property <brush> neutral-stroke-circle: dark-color-scheme ? @linear-gradient(180deg, #FFFFFF17 0%, #FFFFFF12 100%) : @linear-gradient(180deg, #0000000F 0%, #00000029 100%);
    property <brush> neutral-stroke-disabled: dark-color-scheme ? #FFFFFF29 : #00000038;
    property <brush> accent-stroke-control: dark-color-scheme ? @linear-gradient(180deg, #FFFFFF14 90.67%, #00000024 100%) : @linear-gradient(180deg, #FFFFFF14 90.67%, #00000066 100%);
    property <brush> neutral-stroke-control: dark-color-scheme ? @linear-gradient(180deg, #FFFFFF17 0%, #00000012 8.33%) : @linear-gradient(180deg, #0000000F 90.58%, #00000029 100%);
    property <brush> neutral-stroke-control-active: dark-color-scheme ? @linear-gradient(180deg, #FFFFFF14 99.98%, #FFFFFF8A 100%, #FFFFFF8A 100%) : @linear-gradient(180deg, #0000000F 99.99%, #00000073 100%, #00000073 100%);
    property <brush> neutral-stroke-focus-inner: dark-color-scheme ? #000000B3 : #FFFFFF;
    property <brush> neutral-stroke-focus-outer: dark-color-scheme ? #FFFFFF : #000000E6;

    property <brush> accent-fill: accent-color-override.alpha > 0 ? accent-color-override : (dark-color-scheme ? #479EF5 : #0F6CBD);
    property <brush> accent-fill-hover: accent-color-override.alpha > 0 ? accent-color-override.transparentize(8%) : (dark-color-scheme ? #62ABF5 : #115EA3);
    property <brush> accent-fill-pressed: accent-color-override.alpha > 0 ? accent-color-override.transparentize(18%) : (dark-color-scheme ? #2886DE : #0F548C);
    property <brush> accent-fill-disabled: dark-color-scheme ? #2E2E2E : #F0F0F0;
    property <brush> accent-foreground-1: #FFFFFF;
    property <brush> accent-foreground-2: dark-color-scheme ? #000000 : #FFFFFF;
    property <brush> accent-foreground-pressed: dark-color-scheme ? #00000080 : #FFFFFFB3;
    property <brush> accent-foreground-disabled: dark-color-scheme ? #8A8A8A : #BDBDBD;
    property <brush> text-accent-foreground-disabled-fill: accent-foreground-disabled;

    property <brush> control-fill: dark-color-scheme ? #FFFFFF0F : #FFFFFFB3;
    property <brush> control-fill-hover: dark-color-scheme ? #FFFFFF14 : #F5F5F5;
    property <brush> control-fill-pressed: dark-color-scheme ? #FFFFFF0A : #EDEDED;
    property <brush> control-fill-disabled: dark-color-scheme ? #FFFFFF0A : #F5F5F5;
    out property <brush> control-fill-transparent: transparent;
    property <brush> control-alt-fill-secondary: dark-color-scheme ? #0000001A : #00000005;
    property <brush> control-alt-fill-tertiary: dark-color-scheme ? #FFFFFF0A : #0000000F;
    property <brush> control-alt-fill-quaternary: dark-color-scheme ? #FFFFFF12 : #00000017;
    property <brush> control-fill-subtle: dark-color-scheme ? #FFFFFF0F : #0000000A;
    property <brush> control-fill-subtle-hover: dark-color-scheme ? #FFFFFF14 : #0000000F;
    property <brush> control-fill-subtle-pressed: dark-color-scheme ? #FFFFFF0A : #00000014;
    property <brush> control-fill-solid: dark-color-scheme ? #454545 : #FFFFFF;
    property <brush> switch-rail-rest-fill: dark-color-scheme ? #0000001A : #00000005;
    property <brush> switch-rail-hover-fill: dark-color-scheme ? #FFFFFF0A : #0000000F;
    property <brush> switch-rail-pressed-fill: dark-color-scheme ? #FFFFFF12 : #00000017;
    property <brush> menu-frame-stroke: neutral-stroke-1;
    property <brush> menu-frame-fill: neutral-background-1;
    property <brush> menu-flyout-fill: neutral-background-3;
    property <brush> menu-separator-stroke: neutral-stroke-1;
    property <brush> menu-bar-item-foreground-fill: neutral-foreground-1;
    property <brush> menu-bar-item-pressed-foreground-fill: neutral-foreground-2;
    property <brush> menu-bar-item-hover-fill: dark-color-scheme ? #FFFFFF14 : #0000000F;
    property <brush> menu-bar-item-pressed-fill: state-layer-brush.with_alpha(Fluent2SizeSettings.state-layer-active-opacity);
    property <brush> menu-item-foreground-fill: neutral-foreground-1;
    property <brush> menu-item-current-foreground-fill: neutral-foreground-1;
    property <brush> menu-item-current-fill: dark-color-scheme ? #FFFFFF14 : #0000000F;
    property <brush> switch-rail-checked-fill: accent-fill;
    property <brush> switch-rail-checked-hover-fill: accent-fill-hover;
    property <brush> switch-rail-checked-pressed-fill: accent-fill-pressed;
    property <brush> switch-rail-checked-disabled-fill: accent-fill-disabled;
    property <brush> switch-foreground-fill: neutral-foreground-1;
    property <brush> switch-disabled-foreground-fill: neutral-foreground-disabled;
    property <brush> switch-rail-disabled-fill: control-fill-transparent;
    property <brush> switch-rail-border-fill: neutral-stroke-strong;
    property <brush> switch-rail-disabled-border-fill: neutral-stroke-disabled;
    property <brush> switch-thumb-rest-fill: neutral-foreground-2;
    property <brush> switch-thumb-stroke-fill: neutral-stroke-circle;
    property <brush> switch-thumb-checked-fill: accent-foreground-1;
    property <brush> switch-thumb-checked-hover-fill: accent-foreground-1;
    property <brush> switch-thumb-checked-pressed-fill: accent-foreground-1;
    property <brush> switch-thumb-disabled-fill: neutral-foreground-2;
    property <brush> switch-thumb-checked-disabled-fill: accent-foreground-disabled;
    property <brush> input-fill-active: dark-color-scheme ? #1E1E1E : #FFFFFF;
    property <brush> flyout-stroke: dark-color-scheme ? #00000033 : #0000000F;
