import { Fluent2FontSettings, Fluent2Palette, Icons, Fluent2SizeSettings } from "styling.slint";
import { MenuBorder, ListItem, FocusBorder } from "components.slint";
import { ComboBoxBase } from "combobox-base.slint";
import { FocusTouchArea } from "internal-components.slint";
import { ScrollView } from "./scrollview.slint";

export component ComboBox {
    in property <[string]> model <=> base.model;
    in property <bool> enabled <=> base.enabled;
    out property <bool> has-focus <=> base.has-focus;
    in-out property <int> current-index <=> base.current-index;
    in-out property <string> current-value <=> base.current-value;

    callback selected <=> base.selected;

    property <length> popup-padding: Fluent2SizeSettings.combobox-popup-padding;
    property <int> visible-items: min(6, model.length);

    min-width: max(Fluent2SizeSettings.combobox-min-width, layout.min-width);
    min-height: max(Fluent2SizeSettings.combobox-height, layout.min-height);
    horizontal-stretch: 1;
    vertical-stretch: 0;
    forward-focus: base;

    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: base.popup-has-focus;
    accessible-value <=> root.current-value;
    accessible-action-expand => { base.show-popup(); }

    states [
        disabled when !root.enabled : {
            background.background: Fluent2Palette.combobox-disabled-background;
            background.border-color: Fluent2Palette.combobox-disabled-border;
            text.color: Fluent2Palette.combobox-disabled-foreground;
            icon.colorize: Fluent2Palette.combobox-disabled-icon-foreground;
        }
        pressed when base.pressed : {
            background.background: Fluent2Palette.combobox-pressed-background;
            background.border-color: Fluent2Palette.combobox-border;
            text.color: Fluent2Palette.combobox-pressed-foreground;
            icon.colorize: Fluent2Palette.combobox-icon-pressed-foreground;
        }
        hover when base.has-hover : {
            background.background: Fluent2Palette.combobox-hover-background;
        }
        focused when root.has-focus : {
            focus-border.background: Fluent2Palette.combobox-focus-indicator-background;
        }
    ]

    base := ComboBoxBase {
        width: 100%;
        height: 100%;

        show-popup => {
            popup.show();
        }
        close-popup => {
            popup.close();
        }
    }

    background := Rectangle {
        border-radius: Fluent2SizeSettings.combobox-radius;
        background: Fluent2Palette.combobox-background;
        border-width: Fluent2SizeSettings.combobox-border-width;
        border-color: Fluent2Palette.combobox-border;

        animate background, border-color { duration: Fluent2SizeSettings.combobox-motion-duration; }

        layout := HorizontalLayout {
            padding-left: Fluent2SizeSettings.combobox-horizontal-padding;
            padding-right: Fluent2SizeSettings.combobox-horizontal-padding;
            spacing: Fluent2SizeSettings.combobox-content-spacing;

            text := Text {
                horizontal-stretch: 1;
                horizontal-alignment: left;
                vertical-alignment: center;
                font-size: Fluent2FontSettings.body.font-size;
                font-weight: Fluent2FontSettings.body.font-weight;
                font-family: Fluent2Palette.font-family;
                color: Fluent2Palette.combobox-foreground;
                text: root.current-value;
                overflow: elide;
                accessible-role: none;
            }

            icon := Image {
                colorize: Fluent2Palette.combobox-icon-foreground;
                width: Fluent2SizeSettings.combobox-icon-size;
                height: Fluent2SizeSettings.combobox-icon-size;
                source: Icons.dropdown;
                y: Fluent2SizeSettings.combobox-icon-offset-y;
                accessible-role: none;

                animate colorize { duration: Fluent2SizeSettings.combobox-motion-duration; }
            }
        }

        focus-border := Rectangle {
            x: Fluent2SizeSettings.text-input-focus-indicator-horizontal-inset;
            y: parent.height - self.height;
            width: parent.width - 2 * Fluent2SizeSettings.text-input-focus-indicator-horizontal-inset;
            height: Fluent2SizeSettings.combobox-focus-indicator-height;

            animate background { duration: Fluent2SizeSettings.combobox-motion-duration; }
        }
    }

    // focus border
    if root.has-focus && root.enabled : FocusBorder {
        border-radius: background.border-radius;
    }

    popup := PopupWindow {
        x: 0;
        // Position the popup so that the first element is over the popup.
        // Ideally it should be so that the current element is over the popup.
        y: Fluent2SizeSettings.combobox-popup-offset-y;
        width: root.width;
        height: root.visible-items * Fluent2SizeSettings.combobox-popup-item-height +  2 * root.popup-padding;
        close-policy: PopupClosePolicy.close-on-click-outside;
        forward-focus: inner-fs;

        inner-fs := FocusScope {
            focus-changed-event => {
                base.popup-has-focus = self.has-focus;
            }
            key-pressed(event) => {
                return base.popup-key-handler(event);
            }
            MenuBorder {
                // The popup owns wheel and touch-pan gestures while it is open.
                // This prevents a scrollable view behind it from moving.
                ScrollView {
                    mouse-drag-pan-enabled: true;

                    VerticalLayout {
                        alignment: start;
                        padding: root.popup-padding;

                        for value[index] in root.model : ListItem {
                            item: { text: value };
                            is-selected: index == root.current-index;
                            has-hover: touch-area.has-hover;
                            pressed: touch-area.pressed;

                            touch-area := TouchArea {
                                enabled: root.enabled;

                                clicked => {
                                    base.select(index);
                                    popup.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
