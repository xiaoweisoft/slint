export component TestCase {
    width: 320px;
    height: 180px;
    in-out property <int> clicks;

    plane := Rectangle {
        width: 320px;
        height: 180px;
        transform-origin: { x: 160px, y: 90px };
        transform-pitch: 4deg;
        transform-yaw: -6deg;
        transform-perspective: 900px;

        TouchArea {
            clicked => { root.clicks += 1; }
        }
    }

    out property <bool> properties-valid:
        plane.transform-pitch == 4deg
        && plane.transform-yaw == -6deg
        && plane.transform-perspective == 900px;
}

/*
```rust
let instance = TestCase::new().unwrap();
assert!(instance.get_properties_valid());
slint_testing::send_mouse_click(&instance, 160., 90.);
assert_eq!(instance.get_clicks(), 1);
```
*/
